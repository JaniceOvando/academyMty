# Eclipse workspace metadata (incluye sus locks y logs)
# Los .project, .classpath y .settings SI se versionan: son portables y
# permiten importar cada proyecto en Eclipse recien clonado el repo.
.metadata/

# Otros IDEs (el proyecto se versiona en formato Eclipse)
.idea/
*.iml
.vscode/

# Claude Code: ajustes locales de cada maquina.
# .claude/settings.json (el compartido) SI se versiona.
.claude/settings.local.json

# Compiled output
bin/
build/
out/
target/
*.class

# macOS
.DS_Store

# Java
*.jar
# Excepcion: las librerias que un proyecto necesita para compilar SI se versionan,
# porque .classpath las referencia y sin ellas el proyecto no compila al clonar.
!**/lib/*.jar
*.war
# Excepcion: este WAR ya construido SI se versiona, para poder desplegarlo
# en Tomcat directamente desde el repo sin tener que recompilar el proyecto.
!proyectosWeb/proyectoWar/jsp-student-tracker-bonus-search/web-student-tracker-solution.war
*.ear
hs_err_pid*

# Material de apoyo binario y pesado (PDF, PNG y MP4 de ~30 MB en total).
# Se consulta al estudiar el tema, pero no es fuente: si entra al repo se queda
# en la historia de git para siempre y el clon pesa eso de mas para todos.
proyectosWeb/springWebFlux/Conceptos/notebook/

# Tema de testing: trabajo en curso, todavia no publicado al curso.
# Anclado con "/" para que no se trague ningun directorio "testing" que pueda
# existir DENTRO de un proyecto (ahi si seria codigo que se versiona).
/testing/
