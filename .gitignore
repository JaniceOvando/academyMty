# Eclipse workspace metadata
.metadata/
*.lock

# Compiled output
bin/
build/
out/
target/
*.class

# macOS
.DS_Store

# Logs
*.log

# IDE local settings (mantener .project y .classpath, ignorar caches locales)
.recommenders/

# Java
*.jar
# Excepcion: las librerias que un proyecto necesita para compilar SI se versionan,
# porque .classpath las referencia y sin ellas el proyecto no compila al clonar.
!**/lib/*.jar
*.war
*.ear
hs_err_pid*
